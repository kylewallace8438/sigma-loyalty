// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per store that installed the app (created in the afterAuth hook).
model Shop {
  id              Int             @id @default(autoincrement())
  domain          String          @unique // xxx.myshopify.com
  installedAt     DateTime        @default(now())
  uninstalledAt   DateTime?
  discountRules   DiscountRule[]
  customers       Customer[]
  redeemHistories RedeemHistory[]
  orders          Order[]
  gachaSettings   GachaSettings?
  storeSettings   StoreSettings?
  pointHistories  PointHistory[]
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIPPING
}

// Rarity tier of a rule in the gacha reward pool (see app/services/gacha/tiers.js for the odds).
enum GachaTier {
  WHITE
  PURPLE
  GOLD
}

// A reward template: what a discount gives and what it costs in points. Stored only in the app;
// points are exchanged for Shopify discounts manually.
model DiscountRule {
  id                     Int          @id @default(autoincrement())
  shopId                 Int
  shop                   Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title                  String
  pointsCost             Int
  discountType           DiscountType
  discountValue          Decimal?     @db.Decimal(10, 2) // amount (FIXED_AMOUNT) or percent 1-100 (PERCENTAGE)
  minimumSubtotal        Decimal?     @db.Decimal(10, 2)
  usageLimit             Int?
  appliesOncePerCustomer Boolean      @default(true)
  active                 Boolean      @default(true) // off = retired without deleting
  gachaTier              GachaTier? // null = not in the gacha reward pool
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([shopId])
}

// A shop's gacha guarantees ("pity"): the most rolls it can take to get a Gold item, and to get
// a Purple-or-better item. null = no guarantee. See rollWithPity in app/services/gacha/tiers.js.
model GachaSettings {
  id         Int      @id @default(autoincrement())
  shopId     Int      @unique
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  goldPity   Int?
  purplePity Int?
  updatedAt  DateTime @updatedAt
}

// A Shopify customer of a shop, with their loyalty point balance.
model Customer {
  id                Int             @id @default(autoincrement())
  shopId            Int
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyCustomerId String // gid://shopify/Customer/123
  firstName         String?
  lastName          String?
  email             String?
  points            Int             @default(0) // spendable balance; kept equal to the sum of pointHistories
  pointsEarned      Int             @default(0) // lifetime points earned (never lowered by spending); used by VIP tiers
  state             CustomerState   @default(DISABLED) // ENABLED = has a customer account (member), else guest
  excluded          Boolean         @default(false) // excluded by the merchant: earns and redeems nothing
  shopifyCreatedAt  DateTime? // when the customer was created in Shopify
  shopifyUpdatedAt  DateTime? // payload updated_at; an older webhook never overwrites a newer one
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  redeemHistories   RedeemHistory[]
  pointHistories    PointHistory[]

  @@unique([shopId, shopifyCustomerId])
  @@index([shopId, shopifyCreatedAt])
}

// Shopify's customer account state.
enum CustomerState {
  DISABLED
  INVITED
  ENABLED
  DECLINED
}

enum PointHistoryType {
  EARN // an earning rule (order, sign-up, birthday, ...)
  REDEEM // points exchanged for a discount
  ADJUST // added or removed by the merchant
  REFUND // order reward taken back after a refund
  RETURN_CODE // points of a redeemed code given back after a refund
  EXPIRED // balance expired after inactivity
}

// The points ledger: one append-only row per change to a customer's balance.
model PointHistory {
  id         Int              @id @default(autoincrement())
  shopId     Int
  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       PointHistoryType
  points     Int // signed: positive adds to the balance, negative takes away
  reason     String           @db.VarChar(255)
  createdAt  DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([shopId, createdAt])
}

// Program settings, one row per shop (missing row = defaults, see app/services/settings/settings.server.js).
model StoreSettings {
  id                     Int     @id @default(autoincrement())
  shopId                 Int     @unique
  shop                   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  programEnabled         Boolean @default(false) // master switch: when off, nothing is earned or redeemed
  pointsName             String? @db.VarChar(50) // null = "Points"
  includeTax             Boolean @default(false) // order amounts include tax (earning and VIP spend)
  rewardFulfilled        Boolean @default(true) // award order points on fulfilment, not on creation
  rewardGuests           Boolean @default(true) // customers without an account can earn
  refundEnabled          Boolean @default(true) // take back order points after a refund
  returnPointsOnRefund   Boolean @default(true) // give back points spent on a code used in a refunded order
  pointExpirationEnabled Boolean @default(false)
  pointExpirationMonths  Int? // balance expires after this many months without earning or redeeming
}

// One row per points redemption. The customer is referenced by their Shopify gid;
// shopifyDiscountId is the gid of the Shopify discount the points were exchanged for.
model RedeemHistory {
  id                Int      @id @default(autoincrement())
  shopId            Int
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyCustomerId String
  customer          Customer @relation(fields: [shopId, shopifyCustomerId], references: [shopId, shopifyCustomerId], onDelete: Cascade)
  points            Int
  shopifyDiscountId String // gid://shopify/DiscountCodeNode/123
  createdAt         DateTime @default(now())

  @@index([shopId, shopifyCustomerId])
  @@index([shopId, createdAt])
}

// A customer's Shopify order, saved from the orders/create and orders/fulfilled webhooks (one row per order).
// Guest orders can't earn points and aren't stored. Rows are short-lived: orders older than
// ORDER_RETENTION_DAYS are deleted daily (app/services/orders/cleanup.server.js).
// Shopify ids are stored as numbers (not gid strings) to keep the indexes small; the customer
// isn't a relation because they may not have been synced into Customer yet.
model Order {
  id                Int       @id @default(autoincrement())
  shopId            Int
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyOrderId    BigInt // 123 in gid://shopify/Order/123
  shopifyCustomerId BigInt // 123 in gid://shopify/Customer/123
  name              String // #1001
  currency          String
  subtotalPrice     Decimal   @db.Decimal(12, 2) // after discounts, before shipping and tax
  totalDiscounts    Decimal   @db.Decimal(12, 2)
  totalPrice        Decimal   @db.Decimal(12, 2)
  financialStatus   String? // pending | paid | refunded | ...
  fulfillmentStatus String? // null (unfulfilled) | partial | fulfilled | ...
  discountCodes     Json // ["SAVE10"]
  lineItems         Json // [{ id, productId, variantId, quantity, price, discount, giftCard }]; see orderFromPayload
  cancelledAt       DateTime?
  fulfilledAt       DateTime? // latest fulfillment, once the order is fully fulfilled
  shopifyCreatedAt  DateTime
  shopifyUpdatedAt  DateTime // payload updated_at; an older webhook never overwrites a newer one
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([shopId, shopifyOrderId])
  @@index([shopifyCreatedAt]) // retention cleanup, across all shops
}
