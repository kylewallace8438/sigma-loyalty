# ---------- Shopify app ----------
# Values from `shopify app env show`.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Public HTTPS origin of the app (your Cloudflare tunnel hostname). Must match application_url in shopify.app.toml.
SHOPIFY_APP_URL="https://loyalty.example.com"
SCOPES="read_orders,write_metaobject_definitions,write_metaobjects,write_products,write_discounts,read_discounts,read_customers"

# Host port the app container publishes (point the Cloudflare tunnel at http://localhost:APP_PORT).
APP_PORT="3000"

# ---------- MySQL ----------
# Used by prisma.config.ts (CLI/migrations) and app/db.server.js (runtime).
# These values are for running the app on the host; inside docker-compose, DATABASE_HOST/PORT are overridden to mysql:3306.
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3308"
DATABASE_NAME="sigma_loyalty"
DATABASE_USER="sigma"
DATABASE_PASSWORD="sigma"
DATABASE_ROOT_PASSWORD="root"
# DISABLED for the local container; set REQUIRED for a hosted DB (e.g. Aiven).
DATABASE_SSL_MODE="DISABLED"
# Path to the CA certificate when SSL is enabled.
# DATABASE_SSL_CA="ca.pem"
# A full URL overrides the DATABASE_* values above for the Prisma CLI.
# DATABASE_URL="mysql://user:password@host:3306/db"

# ---------- Logging (app/logger.server.js) ----------
# trace | debug | info | warn | error (default: debug in dev, info in production)
LOG_LEVEL="debug"
# Rotated daily: logs/app.<date>.<n>.log, logs/current.log -> active file
LOG_DIR="logs"
# Delete log files older than this many days
LOG_RETENTION_DAYS="30"
# Uncomment to disable file logging (stdout only)
# LOG_FILE="false"

# ---------- Orders (app/services/orders/cleanup.server.js) ----------
# Orders older than this many days (by Shopify creation date) are deleted daily
ORDER_RETENTION_DAYS="30"
