# MySQL connection, used by prisma.config.ts (CLI/migrations) and app/db.server.js (runtime).
# Defaults match docker-compose.yml: `docker compose up -d mysql`
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3308"
DATABASE_NAME="sigma_loyalty"
DATABASE_USER="sigma"
DATABASE_PASSWORD="sigma"
DATABASE_ROOT_PASSWORD="root"

# DISABLED for the local container; set REQUIRED for a hosted DB (e.g. Aiven).
DATABASE_SSL_MODE="DISABLED"
# Path to the CA certificate when SSL is enabled.
# DATABASE_SSL_CA="ca.pem"

# Alternatively, a full URL overrides the DATABASE_* values above for the Prisma CLI.
# DATABASE_URL="mysql://user:password@host:3306/db"

# Logging (app/logger.server.js)
# LOG_LEVEL="debug"        # trace | debug | info | warn | error (default: debug in dev, info in production)
# LOG_DIR="logs"           # rotated daily: logs/app.<date>.<n>.log, logs/current.log -> active file
# LOG_FILE="false"         # disable file logging (stdout only)
