{% liquid
  assign logged_in = false
  if customer
    assign logged_in = true
  endif
%}
<div
  class="sigma-rewards"
  data-sigma-rewards
  data-logged-in="{{ logged_in }}"
  data-proxy="/apps/sigma-loyalty"
  data-currency="{{ shop.currency }}"
  data-account-url="{{ routes.account_url }}"
  style="--sigma-accent: {{ block.settings.accent_color }}; --sigma-accent-text: {{ block.settings.accent_text_color }};"
>
  <script type="application/json" data-sigma-rewards-i18n>
    {
      "pointsUnit": {{ 'rewards.points_unit' | t | json }},
      "waysToEarn": {{ 'rewards.ways_to_earn' | t | json }},
      "perOrder": {{ 'rewards.per_order' | t | json }},
      "perAmount": {{ 'rewards.per_amount' | t | json }},
      "everyBirthday": {{ 'rewards.every_birthday' | t | json }},
      "done": {{ 'rewards.done' | t | json }},
      "claim": {{ 'rewards.claim' | t | json }},
      "editProfile": {{ 'rewards.edit_profile' | t | json }},
      "birthdayLabel": {{ 'rewards.birthday_label' | t | json }},
      "birthdaySave": {{ 'rewards.birthday_save' | t | json }},
      "birthdaySaved": {{ 'rewards.birthday_saved' | t | json }},
      "referralHeading": {{ 'rewards.referral_heading' | t | json }},
      "referralBody": {{ 'rewards.referral_body' | t | json }},
      "referralBodyShort": {{ 'rewards.referral_body_short' | t | json }},
      "copy": {{ 'rewards.copy' | t | json }},
      "copied": {{ 'rewards.copied' | t | json }},
      "earned": {{ 'rewards.earned' | t | json }},
      "actionError": {{ 'rewards.action_error' | t | json }},
      "redeemHeading": {{ 'rewards.redeem_heading' | t | json }},
      "redeem": {{ 'rewards.redeem' | t | json }},
      "notEnough": {{ 'rewards.not_enough' | t | json }},
      "perPoints": {{ 'rewards.per_points' | t | json }},
      "minimumOrder": {{ 'rewards.minimum_order' | t | json }},
      "pointsToSpend": {{ 'rewards.points_to_spend' | t | json }},
      "codeReady": {{ 'rewards.code_ready' | t | json }},
      "yourCodes": {{ 'rewards.your_codes' | t | json }},
      "expires": {{ 'rewards.expires' | t | json }},
      "useNow": {{ 'rewards.use_now' | t | json }},
      "vipHeading": {{ 'rewards.vip_heading' | t | json }},
      "vipCurrent": {{ 'rewards.vip_current' | t | json }},
      "vipNext": {{ 'rewards.vip_next' | t | json }},
      "vipTop": {{ 'rewards.vip_top' | t | json }},
      "vipBonus": {{ 'rewards.vip_bonus' | t | json }},
      "vipEntry": {{ 'rewards.vip_entry' | t | json }},
      "signInToEarn": {{ 'rewards.sign_in_to_earn' | t | json }}
    }
  </script>

  {%- comment -%} Draws the panel sections; the block schema loads rewards-launcher.js. {%- endcomment -%}
  <script src="{{ 'rewards-redeem.js' | asset_url }}" defer></script>
  <script src="{{ 'rewards-earn.js' | asset_url }}" defer></script>

  <dialog
    class="sigma-rewards__panel"
    id="sigma-rewards-panel"
    aria-labelledby="sigma-rewards-title"
    data-sigma-rewards-panel
  >
    <div class="sigma-rewards__header">
      <h2 class="sigma-rewards__title" id="sigma-rewards-title">{{ block.settings.title | escape }}</h2>
      <button
        type="button"
        class="sigma-rewards__close"
        aria-label="{{ 'rewards.close' | t }}"
        data-sigma-rewards-close
      >
        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="sigma-rewards__body">
      {%- if logged_in -%}
        <p class="sigma-rewards__greeting">
          {%- if customer.first_name != blank -%}
            {{ 'rewards.greeting' | t: name: customer.first_name }}
          {%- else -%}
            {{ 'rewards.greeting_anonymous' | t }}
          {%- endif -%}
        </p>
        <div class="sigma-rewards__balance" aria-live="polite">
          <span class="sigma-rewards__label">{{ 'rewards.balance_label' | t }}</span>
          <span class="sigma-rewards__points" data-sigma-rewards-points>&ndash;</span>
          <span class="sigma-rewards__unit" data-sigma-rewards-unit>{{ 'rewards.points_unit' | t }}</span>
        </div>
        <p class="sigma-rewards__message" data-sigma-rewards-error hidden>
          {{ 'rewards.load_error' | t }}
        </p>
        <p class="sigma-rewards__message" data-sigma-rewards-excluded hidden>
          {{ 'rewards.excluded' | t }}
        </p>
        <p class="sigma-rewards__notice" role="status" data-sigma-rewards-notice hidden></p>
        <div class="sigma-rewards__codes" data-sigma-rewards-codes hidden></div>
        <div class="sigma-rewards__referral" data-sigma-rewards-referral hidden></div>
        <div class="sigma-rewards__birthday" data-sigma-rewards-birthday hidden></div>
      {%- else -%}
        <p class="sigma-rewards__message">{{ 'rewards.signed_out' | t }}</p>
        <div class="sigma-rewards__actions">
          <a class="sigma-rewards__cta" href="{{ routes.account_register_url }}">{{ 'rewards.join' | t }}</a>
          <a class="sigma-rewards__link" href="{{ routes.account_login_url }}">{{ 'rewards.sign_in' | t }}</a>
        </div>
      {%- endif -%}
      <div class="sigma-rewards__vip" data-sigma-rewards-vip hidden></div>
      <div class="sigma-rewards__redeem" data-sigma-rewards-redeem hidden></div>
      <div class="sigma-rewards__earn" data-sigma-rewards-earn hidden></div>
    </div>
  </dialog>

  <button
    type="button"
    class="sigma-rewards__launcher"
    aria-label="{{ 'rewards.open' | t }}"
    aria-controls="sigma-rewards-panel"
    aria-expanded="false"
    data-sigma-rewards-toggle
  >
    <svg aria-hidden="true" focusable="false" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="8" width="18" height="4" rx="1"/>
      <path d="M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8"/>
      <path d="M12 8v13"/>
      <path d="M12 8c-1.5-3-5-3.5-5.5-1.5S9 8 12 8z"/>
      <path d="M12 8c1.5-3 5-3.5 5.5-1.5S15 8 12 8z"/>
    </svg>
  </button>
</div>

{% schema %}
{
  "name": "Rewards launcher",
  "target": "body",
  "javascript": "rewards-launcher.js",
  "stylesheet": "rewards-launcher.css",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title.label",
      "default": "Rewards"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color.label",
      "default": "#5c3bfe"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "t:settings.accent_text_color.label",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
